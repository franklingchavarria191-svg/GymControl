<?xml version="1.0" encoding="utf-8"?>
<Report xmlns="http://schemas.microsoft.com/sqlserver/reporting/2008/01/reportdefinition"
        xmlns:rd="http://schemas.microsoft.com/SQLServer/reporting/reportdesigner">
	<DataSources>
		<DataSource Name="GymControl">
			<ConnectionProperties>
				<DataProvider>System.Data.DataSet</DataProvider>
				<ConnectString />
			</ConnectionProperties>
		</DataSource>
	</DataSources>

	<DataSets>
		<DataSet Name="dsIngresosPeriodo">
			<Fields>
				<Field Name="fecha">
					<DataField>fecha</DataField>
				</Field>
				<Field Name="metodo_pago">
					<DataField>metodo_pago</DataField>
				</Field>
				<Field Name="cantidad_pagos">
					<DataField>cantidad_pagos</DataField>
				</Field>
				<Field Name="total_ingresos">
					<DataField>total_ingresos</DataField>
				</Field>
			</Fields>
			<Query>
				<DataSourceName>GymControl</DataSourceName>
				<CommandText />
			</Query>
		</DataSet>
	</DataSets>

	<Body>
		<ReportItems>
			<Textbox Name="txtTitulo">
				<CanGrow>true</CanGrow>
				<Paragraphs>
					<Paragraph>
						<TextRuns>
							<TextRun>
								<Value>GYMCONTROL - INGRESOS POR PERÍODO</Value>
								<Style>
									<FontFamily>Arial</FontFamily>
									<FontSize>16pt</FontSize>
									<FontWeight>Bold</FontWeight>
								</Style>
							</TextRun>
						</TextRuns>
						<Style />
					</Paragraph>
				</Paragraphs>
				<Top>0.2in</Top>
				<Left>0.3in</Left>
				<Height>0.4in</Height>
				<Width>6.8in</Width>
				<Style />
			</Textbox>

			<Tablix Name="tablaIngresos">
				<TablixBody>
					<TablixColumns>
						<TablixColumn>
							<Width>1.5in</Width>
						</TablixColumn>
						<TablixColumn>
							<Width>2in</Width>
						</TablixColumn>
						<TablixColumn>
							<Width>1.5in</Width>
						</TablixColumn>
						<TablixColumn>
							<Width>1.8in</Width>
						</TablixColumn>
					</TablixColumns>

					<TablixRows>
						<TablixRow>
							<Height>0.35in</Height>
							<TablixCells>
								<TablixCell>
									<CellContents>
										<Textbox Name="encFecha">
											<Paragraphs>
												<Paragraph>
													<TextRuns>
														<TextRun>
															<Value>Fecha</Value>
															<Style>
																<FontWeight>Bold</FontWeight>
															</Style>
														</TextRun>
													</TextRuns>
													<Style />
												</Paragraph>
											</Paragraphs>
											<Style />
										</Textbox>
									</CellContents>
								</TablixCell>

								<TablixCell>
									<CellContents>
										<Textbox Name="encMetodo">
											<Paragraphs>
												<Paragraph>
													<TextRuns>
														<TextRun>
															<Value>Método de pago</Value>
															<Style>
																<FontWeight>Bold</FontWeight>
															</Style>
														</TextRun>
													</TextRuns>
													<Style />
												</Paragraph>
											</Paragraphs>
											<Style />
										</Textbox>
									</CellContents>
								</TablixCell>

								<TablixCell>
									<CellContents>
										<Textbox Name="encCantidad">
											<Paragraphs>
												<Paragraph>
													<TextRuns>
														<TextRun>
															<Value>Cantidad</Value>
															<Style>
																<FontWeight>Bold</FontWeight>
															</Style>
														</TextRun>
													</TextRuns>
													<Style />
												</Paragraph>
											</Paragraphs>
											<Style />
										</Textbox>
									</CellContents>
								</TablixCell>

								<TablixCell>
									<CellContents>
										<Textbox Name="encTotal">
											<Paragraphs>
												<Paragraph>
													<TextRuns>
														<TextRun>
															<Value>Total</Value>
															<Style>
																<FontWeight>Bold</FontWeight>
															</Style>
														</TextRun>
													</TextRuns>
													<Style />
												</Paragraph>
											</Paragraphs>
											<Style />
										</Textbox>
									</CellContents>
								</TablixCell>
							</TablixCells>
						</TablixRow>

						<TablixRow>
							<Height>0.3in</Height>
							<TablixCells>
								<TablixCell>
									<CellContents>
										<Textbox Name="datoFecha">
											<Paragraphs>
												<Paragraph>
													<TextRuns>
														<TextRun>
															<Value>=Format(Fields!fecha.Value, "dd/MM/yyyy")</Value>
															<Style />
														</TextRun>
													</TextRuns>
													<Style />
												</Paragraph>
											</Paragraphs>
											<Style />
										</Textbox>
									</CellContents>
								</TablixCell>

								<TablixCell>
									<CellContents>
										<Textbox Name="datoMetodo">
											<Paragraphs>
												<Paragraph>
													<TextRuns>
														<TextRun>
															<Value>=Fields!metodo_pago.Value</Value>
															<Style />
														</TextRun>
													</TextRuns>
													<Style />
												</Paragraph>
											</Paragraphs>
											<Style />
										</Textbox>
									</CellContents>
								</TablixCell>

								<TablixCell>
									<CellContents>
										<Textbox Name="datoCantidad">
											<Paragraphs>
												<Paragraph>
													<TextRuns>
														<TextRun>
															<Value>=CStr(Fields!cantidad_pagos.Value)</Value>
															<Style />
														</TextRun>
													</TextRuns>
													<Style />
												</Paragraph>
											</Paragraphs>
											<Style />
										</Textbox>
									</CellContents>
								</TablixCell>

								<TablixCell>
									<CellContents>
										<Textbox Name="datoTotal">
											<Paragraphs>
												<Paragraph>
													<TextRuns>
														<TextRun>
															<Value>=FormatNumber(Fields!total_ingresos.Value, 2)</Value>
															<Style />
														</TextRun>
													</TextRuns>
													<Style />
												</Paragraph>
											</Paragraphs>
											<Style />
										</Textbox>
									</CellContents>
								</TablixCell>
							</TablixCells>
						</TablixRow>
					</TablixRows>
				</TablixBody>

				<TablixColumnHierarchy>
					<TablixMembers>
						<TablixMember />
						<TablixMember />
						<TablixMember />
						<TablixMember />
					</TablixMembers>
				</TablixColumnHierarchy>

				<TablixRowHierarchy>
					<TablixMembers>
						<TablixMember>
							<KeepWithGroup>After</KeepWithGroup>
						</TablixMember>
						<TablixMember>
							<Group Name="detalleIngresos" />
						</TablixMember>
					</TablixMembers>
				</TablixRowHierarchy>

				<DataSetName>dsIngresosPeriodo</DataSetName>
				<Top>0.8in</Top>
				<Left>0.3in</Left>
				<Height>0.65in</Height>
				<Width>6.8in</Width>
				<Style />
			</Tablix>
		</ReportItems>
		<Height>1.7in</Height>
		<Style />
	</Body>

	<Width>7.5in</Width>

	<Page>
		<PageHeight>11in</PageHeight>
		<PageWidth>8.5in</PageWidth>
		<LeftMargin>0.5in</LeftMargin>
		<RightMargin>0.5in</RightMargin>
		<TopMargin>0.5in</TopMargin>
		<BottomMargin>0.5in</BottomMargin>
		<Style />
	</Page>
</Report>
