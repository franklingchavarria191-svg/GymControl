<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<OutputType>WinExe</OutputType>
		<TargetFramework>net10.0-windows</TargetFramework>
		<StartupObject>GymControl.My.MyApplication</StartupObject>
		<UseWindowsForms>true</UseWindowsForms>
		<MyType>WindowsForms</MyType>
	</PropertyGroup>

	<ItemGroup>
	  <None Remove="Reportes\R04_IngresosPeriodo.rdlc" />
	  <None Remove="Reportes\R05_EstadoCuenta.rdlc" />
	  <None Remove="Reportes\R06_HorarioSemanal.rdlc" />
	</ItemGroup>

	<ItemGroup>
		<Import Include="System.Data" />
		<Import Include="System.Drawing" />
		<Import Include="System.Windows.Forms" />
	</ItemGroup>

	<ItemGroup>
		<Compile Update="My Project\Application.Designer.vb">
			<DesignTime>True</DesignTime>
			<AutoGen>True</AutoGen>
			<DependentUpon>Application.myapp</DependentUpon>
		</Compile>
		<Compile Update="My Project\Resources.Designer.vb">
		  <DesignTime>True</DesignTime>
		  <AutoGen>True</AutoGen>
		  <DependentUpon>Resources.resx</DependentUpon>
		</Compile>
	</ItemGroup>

	<ItemGroup>
		<None Update="conexion.local.json">
		  <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
		</None>
		<None Update="My Project\Application.myapp">
			<Generator>MyApplicationCodeGenerator</Generator>
			<LastGenOutput>Application.Designer.vb</LastGenOutput>
		</None>
	</ItemGroup>

	<ItemGroup>
		<Compile Update="Formularios\frmLogin.vb" />

		<Compile Update="Formularios\frmLogin.Designer.vb">
			<DependentUpon>frmLogin.vb</DependentUpon>
		</Compile>

		<EmbeddedResource Update="Formularios\frmLogin.resx">
			<DependentUpon>frmLogin.vb</DependentUpon>
		</EmbeddedResource>

		<Compile Update="Formularios\frmPrincipal.vb">
			<SubType>Form</SubType>
		</Compile>

		<Compile Update="Formularios\frmPrincipal.Designer.vb">
			<DependentUpon>frmPrincipal.vb</DependentUpon>
		</Compile>

		<EmbeddedResource Update="Formularios\frmPrincipal.resx">
			<DependentUpon>frmPrincipal.vb</DependentUpon>
		</EmbeddedResource>

		<Compile Update="Formularios\frmSocios.vb" />

		<Compile Update="Formularios\frmSocios.Designer.vb">
			<DependentUpon>frmSocios.vb</DependentUpon>
		</Compile>

		<EmbeddedResource Update="Formularios\frmSocios.resx">
			<DependentUpon>frmSocios.vb</DependentUpon>
		</EmbeddedResource>

		<EmbeddedResource Update="My Project\Resources.resx">
		  <CustomToolNamespace>My.Resources</CustomToolNamespace>
		  <Generator>VbMyResourcesResXFileCodeGenerator</Generator>
		  <LastGenOutput>Resources.Designer.vb</LastGenOutput>
		</EmbeddedResource>
	</ItemGroup>

	<ItemGroup>
		<Folder Include="Recursos\" />
	</ItemGroup>

	<ItemGroup>
		<PackageReference Include="ClosedXML" Version="0.105.1" />
		<PackageReference Include="MySql.Data" Version="26.7.0" />
		<PackageReference Include="MySqlConnector" Version="2.6.2" />
		<PackageReference Include="QuestPDF" Version="2026.9.1" />
		<PackageReference Include="ReportViewerCore.WinForms" Version="15.1.33" />
	</ItemGroup>

	<ItemGroup>
	  <Content Include="Reportes\R04_IngresosPeriodo.rdlc">
	    <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
	  </Content>
	  <Content Include="Reportes\R05_EstadoCuenta.rdlc">
	    <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
	  </Content>
	</ItemGroup>

	<ItemGroup>
	  <Content Include="Reportes\R06_HorarioSemanal.rdlc">
	    <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
	  </Content>
	</ItemGroup>

</Project>